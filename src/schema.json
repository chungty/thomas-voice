{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice.chungty.dev/machine/schema.json",
  "title": "Thomas Voice agent contract",
  "request": {
    "type": "object",
    "required": ["surface", "intent", "audience", "authorship", "content"],
    "properties": {
      "surface": {"type": "string"},
      "intent": {"type": "string"},
      "audience": {"type": "object"},
      "authorship": {
        "type": "object",
        "required": ["mode", "may_speak_as_thomas"],
        "properties": {
          "mode": {"const": "draft-for-review"},
          "may_speak_as_thomas": {"const": false},
          "may_attribute_to_thomas": {"const": false}
        }
      },
      "content": {
        "type": "object",
        "required": ["facts"],
        "properties": {
          "facts": {"type": "array"},
          "required_points": {"type": "array"},
          "prohibited_claims": {"type": "array"}
        }
      },
      "constraints": {"type": "object"}
    }
  },
  "response": {
    "type": "object",
    "required": ["draft", "applied_rules", "validation"],
    "properties": {
      "draft": {"type": "string"},
      "applied_rules": {"type": "array", "items": {"type": "string"}},
      "unresolved": {"type": "array"},
      "validation": {"type": "object"}
    }
  }
}
